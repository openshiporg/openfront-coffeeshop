# Openfront Coffee Shop local environment template
# Copy this file to .env and replace the example values for your machine.
# Never commit real credentials in .env.

# Required for Keystone/Prisma runtime and migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/LOCAL_DATABASE
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/LOCAL_SHADOW_DATABASE
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional local auth behavior.
PUBLIC_SIGNUPS_ALLOWED=false

# Optional password-reset email configuration.
SMTP_HOST=localhost
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Openfront Coffee Shop <no-reply@localhost>"
SMTP_STORE_LINK=https://coffee-shop.local

# S3-compatible image storage. Required in production; local development falls back
# to the placeholders in features/keystone/index.ts.
# S3_BUCKET_NAME=keystone-test
# S3_REGION=ap-southeast-2
# S3_ACCESS_KEY_ID=keystone
# S3_SECRET_ACCESS_KEY=keystone
# S3_ENDPOINT=https://sfo3.digitaloceanspaces.com

# Optional server-only payment adapter credentials.
# Online providers remain disabled in onboarding until these values are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENVIRONMENT=sandbox

# Optional dashboard AI chat configuration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=4000
